# ==============================================================================
# Weather Forecast & Alert Application - Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file and rename the copy to '.env'
#    Windows: copy .env.example .env
#    macOS/Linux: cp .env.example .env
# 2. Add your custom API keys if using services that require authentication.
# 3. NEVER commit the actual '.env' file to your Git repository!
# ==============================================================================

# Weather API Selection: 'open-meteo' (default, free, no key needed) or 'openweathermap'
WEATHER_PROVIDER=open-meteo

# OpenWeatherMap API Key (Only needed if WEATHER_PROVIDER is set to 'openweathermap')
# Register for a free API key at: https://home.openweathermap.org/users/sign_up
OPENWEATHER_API_KEY=your_api_key_here

# Default Application Settings
DEFAULT_CITY=Mangaluru
DEFAULT_TEMPERATURE_UNIT=celsius
DEFAULT_WIND_SPEED_UNIT=kmh

# Configurable Alert Thresholds
THRESHOLD_HIGH_TEMP_C=40.0
THRESHOLD_HIGH_HUMIDITY_PCT=85.0
THRESHOLD_HIGH_RAIN_PROB_PCT=70.0
THRESHOLD_HIGH_WIND_SPEED_KMH=50.0
